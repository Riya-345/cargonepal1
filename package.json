{
  "name": "cargonepal",
  "version": "0.1.0",
  "private": true,
  "description": "CargoNepal - instant bike courier & parcel delivery platform for Nepal. Fast. Safe. Parcel First.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cargonepal/web",
    "build": "npm run build --workspace @cargonepal/web",
    "preview": "npm run preview --workspace @cargonepal/web",
    "lint": "npm run lint --workspace @cargonepal/web",
    "typecheck": "npm run typecheck --workspace @cargonepal/web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
